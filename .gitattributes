# Default text normalization: enforce CRLF across structural text files
* text=auto eol=crlf
*.ps1 text eol=crlf
*.md text eol=crlf
*.yml text eol=crlf
*.yaml text eol=crlf
*.json text eol=crlf
*.jsonl text eol=crlf
*.py text eol=crlf

# POSIX shell scripts MUST use LF line endings for Linux and macOS execution
*.sh text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
