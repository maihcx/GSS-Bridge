# Ensure all structural and text files strictly retain CRLF line endings
* text=auto eol=crlf
*.ps1 text eol=crlf
*.sh text eol=crlf
*.md text eol=crlf
*.yml text eol=crlf
*.yaml text eol=crlf
*.json text eol=crlf
*.jsonl text eol=crlf
*.py text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
